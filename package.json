{
  "name": "replyme",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "ReplyMe — an AI communication copilot Chrome extension with a plugin architecture for messaging platforms.",
  "author": "Adrian Le",
  "license": "MIT",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "node scripts/build-extension.mjs",
